{
  "info": {
    "name": "DesignHub Mobile API",
    "description": "Complete API v1 collection for the DesignHub embroidery marketplace (Laravel + Sanctum).\n\nSetup:\n1. Import this collection.\n2. The collection uses the LAN API URL `http://192.168.1.7:8000/api/v1`. Both devices must be on the same network.\n3. Run **Authentication → Request OTP (Register)**. Local development uses the static OTP `1234`.\n4. Run **Verify OTP (Register)**. Use the matching Login requests for an existing phone number. The test script saves `accessToken` automatically.\n5. All authenticated requests use Bearer `{{accessToken}}`.\n\nSuccess responses always contain `success`, `message`, and `data`. Paginated responses also contain `meta` and `links`. Errors contain `success: false`, `message`, and `code`; validation errors also contain field-level `errors`. List endpoints accept `page` and `per_page` (maximum 100).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://192.168.1.7:8000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "user_name", "value": "Postman User" },
    { "key": "country_code", "value": "+91" },
    { "key": "mobile_number", "value": "9876543210" },
    { "key": "otp_code", "value": "1234" },
    { "key": "page", "value": "1" },
    { "key": "per_page", "value": "20" },
    { "key": "design_id", "value": "design_example" },
    { "key": "preview_url", "value": "" },
    { "key": "stitch_url", "value": "" },
    { "key": "razorpay_order_id", "value": "" },
    { "key": "razorpay_payment_id", "value": "" },
    { "key": "razorpay_signature", "value": "" },
    { "key": "signed_download_url", "value": "" },
    { "key": "type_id", "value": "" },
    { "key": "machine_type_id", "value": "machine-embroidery" },
    { "key": "category_id", "value": "neckline" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Request OTP (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has success message', () => pm.expect(json.data.message).to.eql('OTP sent successfully.'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flow\": \"register\",\n  \"name\": \"{{user_name}}\",\n  \"countryCode\": \"{{country_code}}\",\n  \"mobileNumber\": \"{{mobile_number}}\"\n}"
            },
            "url": "{{base_url}}/auth/request-otp"
          }
        },
        {
          "name": "Request OTP (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has success message', () => pm.expect(json.data.message).to.eql('OTP sent successfully.'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flow\": \"login\",\n  \"name\": null,\n  \"countryCode\": \"{{country_code}}\",\n  \"mobileNumber\": \"{{mobile_number}}\"\n}"
            },
            "url": "{{base_url}}/auth/request-otp"
          }
        },
        {
          "name": "Verify OTP (Register)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has access token', () => pm.expect(json.data.accessToken).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flow\": \"register\",\n  \"name\": \"{{user_name}}\",\n  \"countryCode\": \"{{country_code}}\",\n  \"mobileNumber\": \"{{mobile_number}}\",\n  \"code\": \"{{otp_code}}\"\n}"
            },
            "url": "{{base_url}}/auth/verify-otp",
            "description": "Set `otp_code` to the four-digit code from `storage/logs/laravel.log` in local development. A successful response automatically saves the Bearer token."
          }
        },
        {
          "name": "Verify OTP (Login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "}",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has access token', () => pm.expect(json.data.accessToken).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flow\": \"login\",\n  \"name\": null,\n  \"countryCode\": \"{{country_code}}\",\n  \"mobileNumber\": \"{{mobile_number}}\",\n  \"code\": \"{{otp_code}}\"\n}"
            },
            "url": "{{base_url}}/auth/verify-otp",
            "description": "Use after Request OTP (Login). A successful response automatically saves the Bearer token for all authenticated requests."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Current User (me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/users/me"
          }
        },
        {
          "name": "My Designs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/users/me/designs?page={{page}}&per_page={{per_page}}"
          }
        },
        {
          "name": "My Purchases",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/users/me/purchases?page={{page}}&per_page={{per_page}}"
          }
        },
        {
          "name": "My Saved Designs",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/users/me/saved-designs?page={{page}}&per_page={{per_page}}"
          }
        },
        {
          "name": "Save Design",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has success message', () => pm.expect(json.data.message).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/users/me/saved-designs/{{design_id}}"
          }
        },
        {
          "name": "Unsave Design",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has success message', () => pm.expect(json.data.message).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/users/me/saved-designs/{{design_id}}"
          }
        }
      ]
    },
    {
      "name": "Catalog",
      "item": [
        {
          "name": "List Categories and Types",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json.data) && json.data.length && json.data[0].types?.length) {",
                  "  pm.collectionVariables.set('type_id', json.data[0].types[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/catalog/categories"
          }
        },
        {
          "name": "List Design Form Options",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const machine = json.data?.machineTypes?.[0];",
                  "const category = json.data?.categories?.find(item => item.machineTypeIds?.includes(machine?.id));",
                  "if (machine) pm.collectionVariables.set('machine_type_id', machine.id);",
                  "if (category) {",
                  "  pm.collectionVariables.set('category_id', category.id);",
                  "  pm.collectionVariables.set('type_id', category.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/catalog/design-options",
            "description": "Run before Create Design. Saves compatible machine_type_id, category_id, and type_id variables."
          }
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload Preview Photo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.url) {",
                  "  pm.collectionVariables.set('preview_url', json.data.url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "JPG/PNG/WebP, max 5 MB"
                }
              ]
            },
            "url": "{{base_url}}/uploads"
          }
        },
        {
          "name": "Upload Stitch File",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.url) {",
                  "  pm.collectionVariables.set('stitch_url', json.data.url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Stitch file (e.g. .dst), max 5 MB"
                }
              ]
            },
            "url": "{{base_url}}/uploads"
          }
        }
      ]
    },
    {
      "name": "Designs",
      "item": [
        {
          "name": "List Designs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (Array.isArray(json.data) && json.data.length) {",
                  "  pm.collectionVariables.set('design_id', json.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/designs?page={{page}}&per_page={{per_page}}"
          }
        },
        {
          "name": "Get Design",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/designs/{{design_id}}"
          }
        },
        {
          "name": "Create Design",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) {",
                  "  pm.collectionVariables.set('design_id', json.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machineTypeId\": \"{{machine_type_id}}\",\n  \"categoryId\": \"{{category_id}}\",\n  \"typeId\": \"{{type_id}}\",\n  \"showPrice\": true,\n  \"pricePaise\": 29900,\n  \"details\": [\n    {\n      \"names\": [\"Floral neckline\", \"Rose neckline\"],\n      \"stitch\": \"24000\",\n      \"colour\": \"Gold\",\n      \"area\": \"6 x 6\",\n      \"height\": \"6\",\n      \"width\": \"6\"\n    }\n  ],\n  \"images\": [\n    { \"name\": \"front.jpg\", \"uri\": \"{{preview_url}}\" }\n  ],\n  \"files\": [\n    { \"name\": \"floral-neckline.dst\", \"uri\": \"{{stitch_url}}\" }\n  ],\n  \"title\": \"Floral neckline\",\n  \"size\": \"6 x 6\",\n  \"color\": \"Gold\",\n  \"imageUri\": \"{{preview_url}}\",\n  \"fileName\": \"floral-neckline.dst\",\n  \"fileUri\": \"{{stitch_url}}\"\n}"
            },
            "url": "{{base_url}}/designs",
            "description": "Run both upload requests first and ensure preview_url / stitch_url are set."
          }
        },
        {
          "name": "Update Design",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"machineTypeId\": \"{{machine_type_id}}\",\n  \"categoryId\": \"{{category_id}}\",\n  \"typeId\": \"{{type_id}}\",\n  \"showPrice\": true,\n  \"pricePaise\": 34900,\n  \"details\": [\n    {\n      \"names\": [\"Floral neckline v2\", \"Rose neckline\"],\n      \"stitch\": \"26000\",\n      \"colour\": \"Gold\",\n      \"area\": \"6 x 6\",\n      \"height\": \"6\",\n      \"width\": \"6\"\n    }\n  ],\n  \"images\": [\n    { \"name\": \"front.jpg\", \"uri\": \"{{preview_url}}\" }\n  ],\n  \"files\": [\n    { \"name\": \"floral-neckline.dst\", \"uri\": \"{{stitch_url}}\" }\n  ],\n  \"title\": \"Floral neckline v2\",\n  \"size\": \"6 x 6\",\n  \"color\": \"Gold\",\n  \"imageUri\": \"{{preview_url}}\",\n  \"fileName\": \"floral-neckline.dst\",\n  \"fileUri\": \"{{stitch_url}}\"\n}"
            },
            "url": "{{base_url}}/designs/{{design_id}}"
          }
        },
        {
          "name": "Delete Design",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has success message', () => pm.expect(json.data.message).to.eql('Design deleted successfully.'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/designs/{{design_id}}"
          }
        },
        {
          "name": "Request Download URL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.url) {",
                  "  pm.collectionVariables.set('signed_download_url', json.data.url);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/designs/{{design_id}}/download",
            "description": "Owner or paid buyer. Returns short-lived signed URL in data.url."
          }
        },
        {
          "name": "Download Stitch (signed URL)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/octet-stream" }],
            "url": "{{signed_download_url}}",
            "description": "Paste URL from Request Download URL. No Bearer token — signature is in query string."
          }
        }
      ]
    },
    {
      "name": "Purchases & Payments",
      "item": [
        {
          "name": "Purchase Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/purchases/designs/{{design_id}}"
          }
        },
        {
          "name": "Create Payment Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.orderId) {",
                  "  pm.collectionVariables.set('razorpay_order_id', json.data.orderId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designId\": \"{{design_id}}\"\n}"
            },
            "url": "{{base_url}}/payments/orders",
            "description": "Requires RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET in .env"
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"designId\": \"{{design_id}}\",\n  \"razorpay_order_id\": \"{{razorpay_order_id}}\",\n  \"razorpay_payment_id\": \"{{razorpay_payment_id}}\",\n  \"razorpay_signature\": \"{{razorpay_signature}}\"\n}"
            },
            "url": "{{base_url}}/payments/verify"
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "Razorpay Webhook",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "<computed-hmac-sha256-of-raw-body>" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_example\",\n        \"order_id\": \"order_example\",\n        \"amount\": 29900,\n        \"currency\": \"INR\",\n        \"status\": \"captured\"\n      }\n    }\n  }\n}"
            },
            "url": "{{base_url}}/payments/webhook",
            "description": "Configure in Razorpay dashboard. Signature must match RAZORPAY_WEBHOOK_SECRET."
          }
        }
      ]
    }
  ]
}
